{
  "manifest_version": 3,
  "name": "ACP Chat",
  "version": "0.1.0",
  "description": "Chat with ACP CLI harnesses (kiro-cli, Claude Code, Codex, pi, Kimi...) from a panel on any web page.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle ACP Chat on this tab"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/*", "https://google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
